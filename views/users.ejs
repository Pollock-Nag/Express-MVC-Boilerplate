<%- include("partials/header") %>
<%- include("partials/navbar") %>

<main class="container">
  <h1>Users</h1>
  <% if (users.length === 0) { %>
    <p class="empty">No users found.</p>
  <% } else { %>
    <div class="user-list">
      <% users.forEach((user) => { %>
        <article class="user-card">
          <h2><%= user.name %></h2>
          <p><%= user.email %></p>
        </article>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include("partials/footer") %>
